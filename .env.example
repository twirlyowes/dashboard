# Shared code staff enter alongside their Discord ID to log in
DASHBOARD_ACCESS_CODE=

# The SUPPORT bot's own token (used server-side only, to verify guild membership/roles
# for login, and to resolve Discord user IDs into usernames). Never sent to the client.
DISCORD_BOT_TOKEN=

# The Pixel Villa Discord server ID
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs that grant staff-level dashboard access
STAFF_ROLE_IDS=

# Comma-separated Discord USER IDs that grant admin-level (see-everything) dashboard access.
# IDs, not usernames — usernames can change, IDs can't, so trust is anchored to IDs.
DC_ADMINS=

# Long random string used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Paste the ENTIRE downloaded service account JSON file as one single-line value.
# Same format the support bot itself already uses for its own FIREBASE_KEY var —
# this dashboard reads from that exact same Firebase project.
FIREBASE_KEY=

# Optional: soft daily Firestore request budget. Defaults to 30000 if unset. Tracked
# and logged, not hard-enforced — see lib/quota.js for why a hard cutoff would do more
# harm than good.
FIREBASE_DAILY_REQUEST_BUDGET=30000
